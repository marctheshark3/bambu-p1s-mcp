# Copy to .env on the machine that can reach the printer.
# Never commit this file. Never put the access code in a harness config that is git-tracked.

# Required — from printer screen: Settings → Network / Device
BAMBU_IP=192.168.1.50
BAMBU_ACCESS_CODE=xxxxxxxx
BAMBU_SERIAL=01P00A123456789
BAMBU_MODEL=P1S

# Optional MQTT / FTPS
# BAMBU_MQTT_PORT=8883
# BAMBU_FTP_PORT=990
# BAMBU_MQTT_USERNAME=bblp

# Slicer (Bambu Studio CLI). Slice is skipped cleanly if this is missing.
# BAMBU_SLICER=/home/you/.local/bin/bambu-studio
# BAMBU_STUDIO_CONFIG=/home/you/.config/BambuStudio
# BAMBU_MACHINE_JSON=/path/to/Bambu Lab P1S 0.4 nozzle.json
# BAMBU_PROCESS_JSON=/path/to/0.20mm Standard @BBL X1C.json
# BAMBU_FILAMENT_JSON=/path/to/Bambu PLA Basic @BBL P1S 0.4 nozzle.json
# BAMBU_SLICE_DIR=/tmp/bambu-p1s-mcp-slice

# MCP transport when launched as `bambu-p1s-mcp --http`
# Bind 127.0.0.1 if the harness is on this box.
# Bind 0.0.0.0 (and set a token) if Hermes on Spark should connect over LAN/Tailscale.
BAMBU_MCP_HOST=127.0.0.1
BAMBU_MCP_PORT=8765
# BAMBU_MCP_TOKEN=change-me-long-random
# BAMBU_MCP_PATH=/mcp
